# ── 策略脑 (Strategy Brain) 外接 API 配置 ──────────────────────────────
# 策略脑使用【高性能模型】担任顶层架构师：需求分析、方案拆解、答疑、质量终审
STRATEGY_API_KEY=your_strategy_api_key_here
STRATEGY_BASE_URL=https://api.openai.com/v1
STRATEGY_MODEL=gpt-4o

# ── 执行脑 (Executor Brain) 外接 API 配置 ──────────────────────────────
# 执行脑使用【较低性能模型】担任落地执行者：低成本、高吞吐、代码生成落盘
EXECUTOR_API_KEY=your_executor_api_key_here
EXECUTOR_BASE_URL=https://api.openai.com/v1
EXECUTOR_MODEL=gpt-4o-mini

# ── 服务端口 ────────────────────────────────────────────────────────────
PORT=3000
