{
  "name": "ai-orchestrator",
  "version": "3.2.0",
  "description": "Dual-brain AI orchestration: High-performance Strategy Brain (framework + hard parts) + Low-cost Executor Brain (remaining tasks), OpenAI-compatible external APIs, real web search, Web + Electron desktop.",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "electron:start": "electron electron/main.mjs",
    "electron:build": "electron-builder --win portable"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "openai": "^4.47.1",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.amdse.ai-orchestrator",
    "productName": "AI-Orchestrator",
    "files": [
      "backend/**/*",
      "frontend/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "asar": true
  }
}
